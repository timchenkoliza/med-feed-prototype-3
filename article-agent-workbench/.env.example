# Required. Keep secrets server-side only.
OPENAI_API_KEY=

# Optional: compatible Responses API gateway.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Defaults are intentionally split: cheap/fast workers + stronger final auditor.
LLM_MODEL_FAST=gpt-5.6-luna
LLM_MODEL_JUDGE=gpt-5.6-sol

# Optional runtime tuning.
ARTICLE_MAX_CHARS=60000
